# Secrets read by the three Edge Functions at runtime.
#
# Copy to supabase/secrets.env (git-ignored), fill in, then push them with:
#   supabase secrets set --env-file supabase/secrets.env
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase into every Edge Function — do NOT set them here.

# OpenRouter API key (embeddings + metadata extraction). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Your private brain key. Generate one with:  openssl rand -hex 32
# It is sent by every client as the `x-brain-key` header or `?key=` param.
MCP_ACCESS_KEY=replace-with-a-long-random-string

# Owner id for the knowledge graph (ob-graph-mcp). Any UUID you generate once
# and keep. Generate with:  uuidgen | tr 'A-Z' 'a-z'
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# Optional: base URL used in search citations (a dashboard page per thought).
# OPEN_BRAIN_CITATION_BASE_URL=https://example.com/thoughts
