# Config for the local Claude Code scanner (and the import scripts).
# Installed by bootstrap.sh to ~/.open-brain/claude-code-capture/.env.local

# Your Supabase project URL (no trailing slash)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The same brain key you set as the MCP_ACCESS_KEY secret
MCP_ACCESS_KEY=replace-with-your-brain-key

# OPTIONAL. Only for one-off manual runs (backfill-history, cleanup-orphans):
# lets the script patch created_at to the real session date. Never needed by
# the scheduled scanner, so leave it unset in the file launchd reads if you
# prefer to keep the master key out of disk. Supabase → Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=
